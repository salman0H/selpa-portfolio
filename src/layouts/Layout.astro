---
import Cursor from '../components/Cursor';
import '../styles/global.css';
export interface Props {
	title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="fa" dir="rtl" class="motion-safe:scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="description" content="آتلیه چرم سلپا؛ مجموعه‌ای از کیف‌ها، ژورنال‌ها و اکسسوری‌های چرمی دست‌دوز با امکان سفارش و شخصی‌سازی." />
    <meta name="theme-color" content="#e5dcd3" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

        <!-- Prevents GSAP errors when using the browser Back button -->
        <script is:inline>
          if ('scrollRestoration' in history) {
            history.scrollRestoration = 'manual';
          }
        </script>

	</head>
	<body class="bg-zinc-950 text-zinc-50 antialiased">
        <Cursor client:load />
		<slot />
	</body>
</html>
