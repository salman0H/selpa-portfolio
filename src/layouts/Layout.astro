---
import '../styles/global.css';
import CustomCursor from '../components/CustomCursor';

interface Props {
	title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="fa" dir="rtl">
	<head>
		<meta charset="UTF-8" />
        
		<!-- پیش‌بارگذاری فونت‌های حیاتی برای جلوگیری از تاخیر -->
		<link rel="preload" href="/fonts/Lalezar-Regular.ttf" as="font" type="font/ttf" crossorigin="anonymous">
		<link rel="preload" href="/fonts/IRANSansMobile_Light.ttf" as="font" type="font/ttf" crossorigin="anonymous">
		
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
	</head>
	<body class="bg-zinc-950 text-zinc-300 antialiased overflow-x-hidden selection:bg-zinc-700 selection:text-white relative">
		<!-- لایه نویز -->
		<div class="noise-overlay"></div>
		
		<!-- نشانگر سفارشی -->
		<CustomCursor client:load />
		
		<slot />
	</body>
</html>