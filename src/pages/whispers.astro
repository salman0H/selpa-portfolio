---
import Layout from '../layouts/Layout.astro';
import WhisperForm from '../components/WhisperForm';
import { db, Whisper, desc } from 'astro:db';

let whispers: any[] = [];
try {
  whispers = await db.select().from(Whisper).orderBy(desc(Whisper.createdAt));
} catch (e) {
  console.error('Failed to load whispers:', e);
}

const iconicWhispers = whispers.slice(0, 5);
---

<Layout title="Selpa | The Whispers">
  <main id="whispers-main" class="relative min-h-screen bg-[#e5dcd3] text-zinc-950 overflow-hidden">
    
    <!-- Top layer: whispers gallery -->
    <div id="whispers-gallery" class="relative z-20 w-full bg-[#e5dcd3] pb-32 rounded-b-[4rem] shadow-2xl shadow-black/20">
      
      <div class="h-screen flex flex-col justify-center items-center text-center px-4 relative overflow-hidden">
        <!-- Background typography -->
        <h1 class="absolute z-0 font-serif text-[25vw] text-zinc-300 leading-none uppercase tracking-tighter mix-blend-multiply opacity-50 pointer-events-none select-none">
          WHISPERS
        </h1>
        
        <div class="relative z-10 mix-blend-difference text-white">
          <span class="font-serif text-sm md:text-base tracking-[0.5em] uppercase block mb-6">The Hidden Archive</span>
          <h2 class="font-art text-7xl md:text-[10rem] leading-none mb-8" style="text-rendering: optimizeLegibility;">نجواها</h2>
          <p class="font-fa text-lg md:text-xl font-light max-w-lg mx-auto leading-relaxed" dir="rtl">
            صداهایی که در میان چرخ‌دنده‌های تولید انبوه گم نمی‌شوند. اینجا بایگانی تجربیات ناب کسانی است که سلپا را لمس کرده‌اند.
          </p>
        </div>
      </div>

      <!-- Scattered testimonials gallery -->
      <div class="max-w-7xl mx-auto px-4 md:px-20 mt-20">
        {iconicWhispers.length === 0 ? (
          <p class="font-fa text-center text-zinc-500 text-2xl italic my-40">سکوت مطلق. اولین نجوا را شما ثبت کنید.</p>
        ) : (
          <div class="flex flex-col gap-40 md:gap-60 pb-40">
            {iconicWhispers.map((whisper, i) => (
              <div class={`whisper-item relative flex flex-col w-full max-w-4xl ${i % 2 === 0 ? 'md:self-end md:text-right md:items-end' : 'md:self-start md:text-left md:items-start'}`} dir={i % 2 === 0 ? 'rtl' : 'ltr'}>
                <!-- Oversized quotation mark in the background -->
                <span class="absolute -top-20 md:-top-32 font-serif text-[15rem] md:text-[20rem] text-zinc-200 leading-none z-0 pointer-events-none select-none">
                  "
                </span>
                <p class="relative z-10 font-fa text-3xl md:text-6xl font-light leading-tight text-zinc-900 mb-8 mix-blend-multiply" dir="rtl">
                  {whisper.message}
                </p>
                <div class="relative z-10 flex items-center gap-4 opacity-70">
                  <span class="w-12 h-[1px] bg-zinc-900"></span>
                  <span class="font-serif text-sm tracking-widest uppercase">{whisper.author}</span>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>

    <!-- Bottom layer: form footer (reveal effect) -->
    <div id="whisper-footer" class="fixed bottom-0 left-0 w-full h-screen bg-zinc-950 text-[#e5dcd3] z-10 flex flex-col justify-center items-center px-4">
      <div class="text-center mb-16">
        <span class="font-serif text-xs tracking-[0.4em] uppercase text-zinc-500 mb-4 block">Leave Your Mark</span>
        <h3 class="font-fa text-4xl md:text-6xl font-light mb-6">شما چه می‌گویید؟</h3>
        <p class="font-fa text-zinc-400 font-light max-w-md mx-auto" dir="rtl">
          تجربه خود از لمس محصولات سلپا را بنویسید. نجوای شما در این بایگانی جاودانه خواهد شد.
        </p>
      </div>
      
      <div class="w-full max-w-2xl">
        <WhisperForm client:load />
      </div>
    </div>

  </main>

  <script>
    import gsap from 'gsap';
    import ScrollTrigger from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    // 1. Form parallax reveal effect
    const gallery = document.getElementById('whispers-gallery');
    
    if (gallery) {
      const mainElement = document.getElementById('whispers-main');
      if (mainElement) {
        mainElement.style.paddingBottom = '100vh';
      }

      // Fade the top layer and reveal the footer
      gsap.fromTo('#whisper-footer', 
        { yPercent: 30, opacity: 0.5 },
        { 
          yPercent: 0, 
          opacity: 1, 
          ease: 'none',
          scrollTrigger: {
            trigger: gallery,
            start: 'bottom bottom',
            end: '+=100%',
            scrub: true
          }
        }
      );

      // Smoothly reveal each whisper while scrolling
      const items = gsap.utils.toArray('.whisper-item');
      items.forEach((item: any, i) => {
        gsap.fromTo(item, 
          { y: 100, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 1.5,
            ease: 'power4.out',
            scrollTrigger: {
              trigger: item,
              start: 'top 85%',
            }
          }
        );
      });

      // 2. Cinematic scroll on entry
      // Wait briefly for the DOM to finish loading
      setTimeout(() => {
        window.scrollTo({ top: 0 }); // Ensure the page starts at the top
        gsap.to(window, {
          scrollTo: window.innerHeight * 0.5, // Smoothly scroll down by half a viewport
          duration: 2.5,
          ease: 'power3.inOut',
          delay: 0.5 // Brief pause to read the whispers heading
        });
      }, 100);
    }
  </script>
</Layout>