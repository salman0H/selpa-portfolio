---
import Layout from '../layouts/Layout.astro';
import SmoothScroller from '../components/SmoothScroller';
import Hero from '../components/Hero';
import PremiumProducts from '../components/PremiumProducts';
import FloatingArchive from '../components/FloatingArchive';
import ParallaxGallery from '../components/ParallaxGallery';
import HorizontalGallery from '../components/HorizontalGallery';
import TypographyManifesto from '../components/TypographyManifesto';
import ContactExperience from '../components/ContactExperience';
import SecretTrigger from '../components/SecretTrigger';
---

<Layout title="Selpa | Handcrafted Minimal Leather">
  <SecretTrigger client:load />
  
  <SmoothScroller client:load>
    <main>
      <Hero client:load />
      <PremiumProducts client:load />
      <FloatingArchive client:load />
      <ParallaxGallery client:load />
      <HorizontalGallery client:load />
      <TypographyManifesto client:load />
      <ContactExperience client:load />
    </main>
  </SmoothScroller>
</Layout>