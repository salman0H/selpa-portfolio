---
import Layout from '../layouts/Layout.astro';
import Preloader from '../components/Preloader';
import SecretTrigger from '../components/SecretTrigger';
import BackToTop from '../components/BackToTop';
import WhispersOverlay from '../components/WhispersOverlay';
import { db, Whisper } from 'astro:db';

import Hero from '../components/Hero';
import HorizontalGallery from '../components/HorizontalGallery';
import PremiumProducts from '../components/PremiumProducts';
import FloatingArchive from '../components/FloatingArchive';
import ContactExperience from '../components/ContactExperience';

let whispers: any[] = [];
try {
  whispers = await db.select().from(Whisper);
} catch (e) {
  console.error('Failed to load whispers:', e);
}
---

<Layout title="Selpa | Bespoke Leather Craft">
  
  <Preloader client:load />

  <main class="relative w-full overflow-hidden bg-[#e5dcd3]">
    <SecretTrigger client:load />
    
    <Hero client:load />

    <PremiumProducts client:load />
    
    <HorizontalGallery client:load />
    
    <FloatingArchive client:load />
    
    <ContactExperience client:load />
  </main>

  <WhispersOverlay whispers={whispers} client:load />
  <BackToTop client:load />
  
</Layout>